[Unit]
Description=VictoriaMetrics – metrics storage and PromQL
After=observability-pod.service
Requires=observability-pod.service

[Container]
Image=victoriametrics/victoria-metrics:latest
Pod=observability.pod
Volume=observability-metrics.volume:/var/lib/victoriametrics:z
Exec=-storageDataPath=/var/lib/victoriametrics -httpListenAddr=:8428 -retentionPeriod=12 -enableTCP6

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
