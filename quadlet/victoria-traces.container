[Unit]
Description=VictoriaTraces – trace storage and query
After=observability-pod.service
Requires=observability-pod.service

[Container]
Image=victoriametrics/victoria-traces:latest
Pod=observability.pod
Volume=observability-traces.volume:/var/lib/victoriatraces:z
Exec=-storageDataPath=/var/lib/victoriatraces -httpListenAddr=:10428 -enableTCP6

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
