[Unit]
Description=VictoriaLogs – log storage and query
After=observability-pod.service
Requires=observability-pod.service

[Container]
Image=docker.io/victoriametrics/victoria-logs:latest
Pod=observability.pod
Volume=observability-logs.volume:/var/lib/victorialogs:z
Exec=-storageDataPath=/var/lib/victorialogs -httpListenAddr=:9428 -enableTCP6

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
